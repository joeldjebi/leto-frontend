# Back-office VITE (Apache / cPanel)
Options -Indexes
DirectoryIndex index.html

# Toujours en HTTPS (l'API n'accepte que https://vite.ci)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # Politique de sécurité propre au back-office : remplace celle héritée d'un .htaccess parent
  # (qui bloquait les appels vers l'API). Autorise l'API + temps réel, les cartes OpenStreetMap, les photos et les sons (Wasabi).
  Header always unset Content-Security-Policy
  Header unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.vite.ci https://*.wasabisys.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://api.maptiler.com https://api.mapbox.com https://tile.googleapis.com; media-src 'self' blob: https://api.vite.ci https://*.wasabisys.com; connect-src 'self' https://api.vite.ci wss://api.vite.ci; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # Fichiers versionnés par Vite : cache long
  <FilesMatch "\.(js|css|woff2?|svg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Service worker des notifications : toujours vérifié (sinon les mises à jour tardent)
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
  # Page d'entrée : toujours la dernière version
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
